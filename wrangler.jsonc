{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bettermandaluyong-org",
  "compatibility_date": "2026-11-01",
  // Static-assets-only Worker: no script, Cloudflare serves ./public directly.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches.
  "previews": {},
  // www is not attached here: a Cloudflare Redirect Rule sends it to the root domain.
  "routes": [{ "pattern": "bettermandaluyong.org", "custom_domain": true }]
}
